<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main>
      <div class="page-heading"><div><span class="eyebrow">Host dashboard</span><h1>Your spaces,<br>beautifully managed.</h1></div><a href="/host/add-home" class="button">Add a home <span aria-hidden="true">&#43;</span></a></div>
      <div class="listing-grid">
        <% registeredHomes.forEach(home => { %>
          <div class="stay-card">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>">
            <div class="stay-card-body">
              <h3><%= home.houseName %></h3>
              <p class="location">&#9906; <%= home.location %></p>
              <div class="card-meta"><span class="price">Rs<%= home.price %> / night</span><span class="rating"><span>&#9733;</span> <%= home.rating %></span></div>
              <div class="admin-actions"><a href="/host/edit-home/<%=home._id%>?editing=true" class="button button-outline">Edit</a><form action="/host/delete-home/<%= home._id %>" method="POST"><button type="submit" class="button">Delete</button></form></div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a href="/" class="brand" aria-label="Airbnb home">
      <span class="brand-mark">A</span>
      <span>airbnb</span>
    </a>

    <div class="nav-links">
      <% if (isLoggedIn) { %>
        <% if (user && user.userType === 'guest') { %>
          <a href="/homes" class="nav-link <%= currentPage === 'Home' ? 'is-active' : '' %>">Explore stays</a>
          <a href="/favourites" class="nav-link <%= currentPage === 'favourites' ? 'is-active' : '' %>">Favourites</a>
          <a href="/bookings" class="nav-link <%= currentPage === 'bookings' ? 'is-active' : '' %>">Bookings</a>
        <% } else { %>
          <a href="/host/host-home-list" class="nav-link <%= currentPage === 'host-homes' ? 'is-active' : '' %>">Your homes</a>
          <a href="/host/add-home" class="nav-link <%= currentPage === 'addHome' ? 'is-active' : '' %>">Add a home</a>
        <% } %>
      <% } %>
    </div>

    <div class="nav-actions">
      <% if (!isLoggedIn) { %>
        <a href="/login" class="nav-login <%= currentPage === 'login' ? 'is-current' : '' %>">Log in</a>
        <a href="/signup" class="button button-small"><span>Get started</span><span aria-hidden="true">&#8599;</span></a>
      <% } else { %>
        <span class="avatar" aria-hidden="true"><%= user && user.firstName ? user.firstName.charAt(0).toUpperCase() : 'U' %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="nav-logout">Log out</button>
        </form>
      <% } %>
    </div>

    <button id="mobile-menu-button" class="mobile-menu-button" type="button" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>
  <div id="mobile-menu" class="mobile-menu">
    <% if (isLoggedIn) { %>
      <% if (user && user.userType === 'guest') { %>
        <a href="/homes">Explore stays</a>
        <a href="/favourites">Favourites</a>
        <a href="/bookings">Bookings</a>
      <% } else { %>
        <a href="/host/host-home-list">Your homes</a>
        <a href="/host/add-home">Add a home</a>
      <% } %>
    <% } else { %>
      <a href="/login">Log in</a>
      <a href="/signup">Get started</a>
    <% } %>
  </div>
</header>
<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('is-open');
      menuButton.setAttribute('aria-expanded', isOpen);
    });
  }
</script>

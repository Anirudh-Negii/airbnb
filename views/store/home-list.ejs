<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main>
      <div class="page-heading"><div><span class="eyebrow">Explore the collection</span><h1>Stay somewhere<br>worth remembering.</h1></div><p>Homes with a little more soul.</p></div>
      <div class="listing-grid">
        <% registeredHomes.forEach(home => { %>
          <div class="stay-card">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>">
            <div class="stay-card-body">
              <h3><%= home.houseName %></h3>
              <p class="location">&#9906; <%= home.location %></p>
              <div class="card-meta"><span class="price">Rs<%= home.price %> / night</span><span class="rating"><span>&#9733;</span> <%= home.rating %></span></div>
              <div class="card-actions"><a class="button button-outline" href="/homes/<%= home._id %>">View details</a><%- include('../partials/favourite', {home: home}) %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>

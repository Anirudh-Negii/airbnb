<%- include('../partials/head') %>
  </head>
  <body>
      <%- include('../partials/nav') %>
      <main>
          <div class="detail-layout">
              <div>
                  <img src="<%= home.photo %>" alt="<%= home.name %>" class="detail-image">
              </div>
              
              <div class="detail-copy">
                  <span class="eyebrow">A stay with character</span>
                  <h1><%= home.houseName %></h1>
                  <p class="location">&#9906; <%= home.location %></p>
                  <p class="detail-description"><%= home.description %></p>
                  <div class="detail-summary"><div><span class="eyebrow">From</span><strong>Rs<%= home.price %> / night</strong></div><div><span class="eyebrow">Guest rating</span><strong><span class="rating"><span>&#9733;</span> <%= home.rating %> / 5</span></strong></div></div>
                  <div>
                    <%- include('../partials/favourite') %>
                  </div>
              </div>
          </div>
      </main>
  </body>
</html>

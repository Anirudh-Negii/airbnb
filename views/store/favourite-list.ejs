<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main>
      <div class="page-heading"><div><span class="eyebrow">Your shortlist</span><h1>Places you<br>keep thinking about.</h1></div><p>Your saved stays, all in one place.</p></div>
      <div class="listing-grid">
        <% favouriteHomes.forEach(home => { %>
          <div class="stay-card">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>">
            <div class="stay-card-body">
              <h3><%= home.houseName %></h3>
              <p class="location">&#9906; <%= home.location %></p>
              <div class="card-meta"><span class="price">Rs<%= home.price %> / night</span><span class="rating"><span>&#9733;</span> <%= home.rating %></span></div>
              <form action="/favourites/delete/<%= home._id %>" method="POST">
                <button class="button button-outline button-full" type="submit">Remove from favourites</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
